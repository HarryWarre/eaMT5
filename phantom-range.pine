//@version=5
strategy("Phantom Range - Triple Screen", overlay=true, initial_capital=10000, calc_on_every_tick=true, process_orders_on_close=true, pyramiding=20)

// ==========================================
// THIẾT LẬP THÔNG SỐ (INPUTS)
// ==========================================

// --- Window 1 (D1) - Macro Range Filter ---
group_w1 = "Window 1 (Macro Filter) - D1"
tf_w1 = input.timeframe("1D", title="Timeframe W1", group=group_w1)
adx_len = input.int(14, title="ADX Length", group=group_w1)
adx_max = input.float(25.0, title="ADX Max Threshold (Range Limit)", group=group_w1)

// --- Window 2 (H1) - Reversal Setup ---
group_w2 = "Window 2 (Reversal Setup) - H1"
tf_w2 = input.timeframe("60", title="Timeframe W2", group=group_w2)
stoch_k = input.int(14, title="Stochastic %K Length", group=group_w2)
stoch_d = input.int(3, title="Stochastic %D Length", group=group_w2)
stoch_smooth = input.int(3, title="Stochastic Smoothing", group=group_w2)
stoch_ob = input.float(80.0, title="Overbought Level", group=group_w2)
stoch_os = input.float(20.0, title="Oversold Level", group=group_w2)
armed_bars = input.int(15, title="Armed Duration (Chart Bars)", group=group_w2, tooltip="Số lượng nến duy trì trạng thái Lên đạn sau khi W2 thoả mãn.")

// --- Window 3 (M15) - Execution & DCA ---
group_w3 = "Window 3 (Execution) - Chart TF"
bb_len = input.int(20, title="Bollinger Bands Length", group=group_w3)
bb_mult = input.float(2.0, title="Bollinger Bands StdDev", group=group_w3)
ema_fast_len = input.int(9, title="Fast EMA Length (Trigger)", group=group_w3)

group_dca = "DCA & Position Sizing"
qty_percent = input.float(10.0, title="Initial Order Size (% Equity)", group=group_dca)
max_dca = input.int(10, title="Max DCA Orders", group=group_dca, tooltip="Số lượng lệnh DCA tối đa. Khuyến nghị cài mức cao (Vd: 10) vì chiến lược không còn Stoploss tĩnh.")
dca_lot_mult = input.float(1.5, title="DCA Lot Multiplier", group=group_dca)

// ==========================================
// LOGIC WINDOW 1 (MACRO RANGE FILTER)
// ==========================================

f_w1() =>
    [diplus, diminus, adx] = ta.dmi(adx_len, adx_len)
    is_ranging = adx < adx_max
    [is_ranging, adx]

[w1_ranging, w1_adx] = request.security(syminfo.tickerid, tf_w1, f_w1(), lookahead=barmerge.lookahead_off)

// ==========================================
// LOGIC WINDOW 2 (REVERSAL SETUP / ARMED)
// ==========================================

f_w2() =>
    k = ta.sma(ta.stoch(close, high, low, stoch_k), stoch_smooth)
    d = ta.sma(k, stoch_d)
    is_ob = k > stoch_ob // Overbought -> Setup Short
    is_os = k < stoch_os // Oversold -> Setup Long
    [is_ob, is_os, k, d]

[w2_ob, w2_os, w2_k, w2_d] = request.security(syminfo.tickerid, tf_w2, f_w2(), lookahead=barmerge.lookahead_off)

// Trạng thái Lên Đạn (Armed)
var int bars_since_os = 9999
var int bars_since_ob = 9999

if w2_os
    bars_since_os := 0
else
    bars_since_os += 1

if w2_ob
    bars_since_ob := 0
else
    bars_since_ob += 1

// Điều kiện chung: Đang trong Range + Mới rời khỏi quá mua/quá bán trong vòng N nến
is_armed_long = w1_ranging and bars_since_os <= armed_bars
is_armed_short = w1_ranging and bars_since_ob <= armed_bars

// ==========================================
// LOGIC WINDOW 3 (EXECUTION)
// ==========================================

[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_len, bb_mult)
ema_fast = ta.ema(close, ema_fast_len)

// Trigger bóp cò (Tín hiệu): Giá đâm thủng ra band ngoài và quay đầu đóng cửa vào trong
trigger_long = ta.crossover(close, bb_lower)
trigger_short = ta.crossunder(close, bb_upper)

// ==========================================
// VÀO LỆNH (INITIAL & DCA) VÀ QUẢN LÝ LỆNH
// ==========================================

base_qty = (strategy.equity * (qty_percent / 100)) / close

enter_long_initial = is_armed_long and trigger_long and strategy.position_size == 0
enter_short_initial = is_armed_short and trigger_short and strategy.position_size == 0

last_entry_price = strategy.opentrades > 0 ? strategy.opentrades.entry_price(strategy.opentrades - 1) : na

// Logic DCA: Dựa vào TÍN HIỆU (Trigger) thay vì khoảng cách tĩnh. 
// Chỉ nhồi thêm lệnh khi có tín hiệu mới ở band ngoài và giá bất lợi hơn lệnh trước đó.
dca_long_cond = strategy.position_size > 0 and strategy.opentrades <= max_dca and trigger_long and close < last_entry_price
dca_short_cond = strategy.position_size < 0 and strategy.opentrades <= max_dca and trigger_short and close > last_entry_price


if enter_long_initial
    strategy.entry("Long_0", strategy.long, qty=base_qty)

if enter_short_initial
    strategy.entry("Short_0", strategy.short, qty=base_qty)

if dca_long_cond
    dca_qty = base_qty * math.pow(dca_lot_mult, strategy.opentrades)
    strategy.entry("Long_DCA_" + str.tostring(strategy.opentrades), strategy.long, qty=dca_qty)

if dca_short_cond
    dca_qty = base_qty * math.pow(dca_lot_mult, strategy.opentrades)
    strategy.entry("Short_DCA_" + str.tostring(strategy.opentrades), strategy.short, qty=dca_qty)


// ==========================================
// THOÁT LỆNH (EXIT MANAGEMENT)
// ==========================================

avg_price = strategy.position_avg_price

// Đánh hồi quy về đường Mid (Middle Band) theo yêu cầu
tp_long = bb_mid
tp_short = bb_mid

// 1. Chốt lời bình thường khi chạm Mid
if strategy.position_size > 0
    strategy.exit("Exit Longs", limit=tp_long)
    
if strategy.position_size < 0
    strategy.exit("Exit Shorts", limit=tp_short)

// 2. Đóng toàn bộ lệnh (Emergency Exit) khi Window 1 báo thị trường chuyển sang Trend
if not w1_ranging and strategy.position_size != 0
    strategy.close_all(comment="Trend Breakout Exit")


// ==========================================
// PLOTTING
// ==========================================

plot(ema_fast, color=color.orange, title="Fast EMA")
p_upper = plot(bb_upper, color=color.new(color.blue, 70), title="BB Upper")
p_lower = plot(bb_lower, color=color.new(color.blue, 70), title="BB Lower")
p_mid = plot(bb_mid, color=color.new(color.gray, 50), title="BB Mid")

// Vẽ khu vực W1 Ranging
bgcolor(w1_ranging ? color.new(color.blue, 95) : na, title="Ranging Background")

// Hiển thị Armed background
bgcolor(is_armed_long ? color.new(color.green, 90) : is_armed_short ? color.new(color.red, 90) : na, title="Armed Setup Background")

// Gộp chung điều kiện vào lệnh để hiển thị mũi tên
is_long_entry = enter_long_initial or dca_long_cond
is_short_entry = enter_short_initial or dca_short_cond

plotshape(is_long_entry, title="Long Entry", location=location.belowbar, color=color.new(color.green, 0), style=shape.triangleup, size=size.small)
plotshape(is_short_entry, title="Short Entry", location=location.abovebar, color=color.new(color.red, 0), style=shape.triangledown, size=size.small)

// Hiển thị vòng tròn đóng lệnh
exit_long = strategy.position_size[1] > 0 and strategy.position_size == 0
exit_short = strategy.position_size[1] < 0 and strategy.position_size == 0

plotshape(exit_long, title="Exit Long", location=location.abovebar, color=color.new(color.orange, 0), style=shape.circle, size=size.small)
plotshape(exit_short, title="Exit Short", location=location.belowbar, color=color.new(color.orange, 0), style=shape.circle, size=size.small)

// Vẽ đường Giá trung bình
plot(strategy.position_size != 0 ? avg_price : na, color=color.yellow, style=plot.style_linebr, linewidth=2, title="Average Price")


// ==========================================
// DASHBOARD
// ==========================================
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast
    // Header
    table.cell(dash, 0, 0, "PHANTOM RANGE", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.blue, 50))
    table.cell(dash, 1, 0, "STATUS", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.blue, 50))
    
    // W1 Status
    w1_status_text = w1_ranging ? "RANGING (ADX " + str.tostring(w1_adx, "#.#") + ")" : "TRENDING (ADX " + str.tostring(w1_adx, "#.#") + ")"
    w1_status_color = w1_ranging ? color.green : color.red
    table.cell(dash, 0, 1, "W1 (D1) Phase", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, w1_status_text, text_color=w1_status_color, text_size=size.small)
    
    // W2 Status
    w2_status_text = is_armed_long ? "ARMED LONG (OS)" : is_armed_short ? "ARMED SHORT (OB)" : "WAITING EXTREMES"
    w2_status_color = is_armed_long ? color.green : is_armed_short ? color.red : color.gray
    table.cell(dash, 0, 2, "W2 (H1) Setup", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, w2_status_text, text_color=w2_status_color, text_size=size.small)
    
    // W3 Status
    w3_status_text = strategy.position_size > 0 ? "IN LONG (" + str.tostring(strategy.opentrades) + ")" : strategy.position_size < 0 ? "IN SHORT (" + str.tostring(strategy.opentrades) + ")" : "WAITING TRIGGER"
    w3_status_color = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dash, 0, 3, "W3 (M15) Exec", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, w3_status_text, text_color=w3_status_color, text_size=size.small)
    
    // Avg Price
    table.cell(dash, 0, 4, "Avg Price", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, strategy.position_size != 0 ? str.tostring(avg_price, "#.#####") : "N/A", text_color=color.yellow, text_size=size.small)
    
    // Statistics
    table.cell(dash, 0, 5, "--- STATS ---", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, "-------------", text_color=color.gray, text_size=size.small)
    
    total_trades = strategy.closedtrades
    win_trades = 0
    if total_trades > 0
        for i = 0 to total_trades - 1
            if strategy.closedtrades.profit(i) > 0
                win_trades += 1
                
    winrate = total_trades > 0 ? (win_trades / total_trades) * 100 : 0
    stats_text = str.tostring(total_trades) + " Trades | " + str.tostring(winrate, "#.##") + "% WR"
    
    table.cell(dash, 0, 6, "Performance", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, stats_text, text_color=color.yellow, text_size=size.small)
